# ProductIQ Application Environment Configuration
ENVIRONMENT=development

# PostgreSQL Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/productiq

# Ollama LLM Configuration
MODEL_NAME=llama3.1
OLLAMA_HOST=http://localhost:11434
TEMPERATURE=0.2
MAX_RETRIES=2
OLLAMA_TIMEOUT=120.0

# Logging & CORS
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:80,http://localhost
